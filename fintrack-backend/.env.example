SECTORS_API_KEY=isi_disini

# Kunci OpenRouter untuk endpoint POST /api/chat, dari
# https://openrouter.ai/keys. Isi di .env, bukan di sini: berkas .env.example
# ikut masuk repositori, jadi jangan pernah menulis kunci asli di baris ini.
OPENROUTER_API_KEY=isi_disini

# Opsional. Default "*" supaya demo lewat browser (`expo start --web`) jalan.
# Isi beberapa origin dipisah koma bila ingin membatasi, contoh:
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://192.168.1.5:8081
CORS_ALLOWED_ORIGINS=*
